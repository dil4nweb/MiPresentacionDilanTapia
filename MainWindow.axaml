<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiPresentacionDilanTapia.MainWindow"
        Title="Mi Presentacion"
        Width="500"
        Height="650"
        MinWidth="400"
        MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="Aplicacion grafica"
                   FontSize="25"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,10,0,20"/>

        <TextBlock Text="Nombre:"
                   FontWeight="Bold"/>

        <TextBox x:Name="txtNombre"
                 Watermark="Escribe tu nombre"/>

        <TextBlock Text="Apellido:"
                   FontWeight="Bold"/>

        <TextBox x:Name="txtApellido"
                 Watermark="Escribe tu apellido"/>

        <TextBlock Text="Edad:"
                   FontWeight="Bold"/>

        <TextBox x:Name="txtEdad"
                 Watermark="Escribe tu edad"/>

        <Button Content="Presentarme"
                Click="Presentarme_Click"
                HorizontalAlignment="Stretch"
                Margin="0,15,0,0"/>

        <Button Content="Limpiar"
                Click="Limpiar_Click"
                HorizontalAlignment="Stretch"/>

        <Button Content="Cambiar saludo"
                Click="CambiarSaludo_Click"
                HorizontalAlignment="Stretch"/>

        <TextBlock x:Name="txtResultado"
                   Text="Aqui aparecera la presentacion"
                   TextWrapping="Wrap"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,20,0,0"/>

    </StackPanel>
</Window>
